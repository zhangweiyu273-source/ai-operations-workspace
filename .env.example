# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_NAME=AI运营工作台
APP_VERSION=0.1.0
LOG_LEVEL=INFO

POSTGRES_DB=ai_ops
POSTGRES_USER=ai_ops
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://ai_ops:change-me-in-local-env@db:5432/ai_ops
POSTGRES_TEST_DB=ai_ops_test
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql+psycopg://ai_ops:change-me-in-local-env@localhost:5433/ai_ops_test
DEFAULT_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=/api/v1
BACKEND_INTERNAL_URL=http://backend:8000/api/v1
CORS_ORIGINS=http://localhost:3000

AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

UPLOAD_DIR=/app/storage/uploads
MAX_UPLOAD_SIZE_MB=20
